#!/bin/bash
#SBATCH --job-name={{ resources.name }}
#SBATCH -p {{ resources.partition }}
#SBATCH -t {{ resources.time }}
#SBATCH --nodes={{ resources.nodes }}
#SBATCH --ntasks={{ resources.ntasks }}
#SBATCH --cpus-per-task={{ resources.cpus_per_task }}
{% if resources.gpus -%}
#SBATCH --gpus={{ resources.gpus }}
{% endif -%}
{% if resources.mem_per_gpu -%}
#SBATCH --mem-per-gpu={{ resources.mem_per_gpu }}
{% elif resources.mem -%}
#SBATCH --mem={{ resources.mem }}
{% endif -%}
#SBATCH --output={{ log_path }}

{% for module in resources.modules -%}
module load {{ module }}
{% endfor %}
{{ command }}